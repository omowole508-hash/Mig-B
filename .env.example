# Copy this file to .env and fill in the real values in Railway.
# Do not commit real secrets.

RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
WALLET_PRIVATE_KEY=BASE58_OR_B58_SECRET_KEY
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
JUPITER_API_KEY=YOUR_JUPITER_API_KEY
PUMPPORTAL_API_KEY=YOUR_PUMPPORTAL_API_KEY
JSONBIN_BIN_ID=
JSONBIN_API_KEY=

# Optional if you prefer a direct RPC instead of HELIUS_API_KEY
HELIUS_API_KEY=
